{
  "name": "pi-conduct",
  "version": "0.1.0",
  "description": "Pi extension that adds a /conduct slash command for orchestrated multi-agent coding workflows.",
  "type": "module",
  "keywords": ["pi-package"],
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "scripts": {
    "clean": "rm -rf .pi/conduct/runs",
    "build": "tsc --noEmit",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "typescript": "^5",
    "tsx": "^4",
    "@types/node": "^22"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.82.1",
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@earendil-works/pi-tui": "^0.82.1"
  }
}
